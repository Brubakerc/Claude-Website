---
// The body of the Projects page and of each tag page.
import ProjectCard from "./ProjectCard.astro";
import TagFilter from "./TagFilter.astro";
import type { Project } from "../lib/projects";

interface Props {
  title: string;
  intro: string;
  all: Project[]; // every published project, for numbering
  shown: Project[];
  tags: { slug: string; label: string }[];
  current?: string;
}
const { title, intro, all, shown, tags, current } = Astro.props;
---

<div class="wrap page-head">
  <h1 class="page-head__title">{title}</h1>
  <p class="page-head__intro" data-filter-count>{intro}</p>
</div>
<div class="wrap" data-project-index={current ? undefined : ""}>
  <TagFilter tags={tags} current={current} />
  <ul class="card-grid card-grid--index">
    {shown.map((p) => <ProjectCard project={p} number={all.indexOf(p) + 1} heading="h2" />)}
  </ul>
</div>

<script>
  // On the main Projects page, filter in place instead of loading the tag page.
  const index = document.querySelector<HTMLElement>("[data-project-index]");
  if (index) {
    const cards = [...index.querySelectorAll<HTMLElement>(".card")];
    const links = [...index.querySelectorAll<HTMLAnchorElement>(".tag[data-tag]")];
    const count = document.querySelector<HTMLElement>("[data-filter-count]");
    const original = count?.textContent ?? "";
    index.addEventListener("click", (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>(".tag[data-tag]");
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      const tag = link.dataset.tag!;
      let visible = 0;
      for (const card of cards) {
        const match = !tag || (card.dataset.tags ?? "").split(" ").includes(tag);
        card.hidden = !match;
        if (match) visible++;
      }
      for (const l of links) {
        if (l === link) l.setAttribute("aria-current", "page");
        else l.removeAttribute("aria-current");
      }
      if (count) count.textContent = tag ? `${visible} ${visible === 1 ? "project" : "projects"} tagged ${link.textContent!.trim()}.` : original;
      history.replaceState(history.state, "", link.href);
    });
  }
</script>
