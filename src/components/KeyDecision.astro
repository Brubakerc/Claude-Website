---
// The block for a major engineering decision. Inside it, write the options,
// constraints, analysis, and outcome in plain Markdown (### headings work well).
//   <KeyDecision title="Bearing arrangement">
//   ### Options
//   ...
//   </KeyDecision>
import { slugifyTag, todo } from "../lib/util";

interface Props {
  title: string;
}
const { title } = Astro.props;
if (!title) throw new Error(`<KeyDecision> needs a title, e.g. <KeyDecision title="Bearing arrangement">`);
const id = `decision-${slugifyTag(title)}`;
---

<section class="key-decision" aria-labelledby={id}>
  <p class="key-decision__label">Key decision</p>
  <h2 class="key-decision__title" id={id} set:html={todo(title)} />
  <div class="key-decision__body"><slot /></div>
</section>
